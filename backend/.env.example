# Local development defaults to SQLite if DATABASE_URL is omitted.
# Neon provides a PostgreSQL URI; use the pooled connection string for the web app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated browser origins; include your GitHub Pages origin and localhost.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Required for signed admin API access. Use a long random value.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password

# Cloudinary credentials. Never put these in frontend files.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Modem Pay credentials. Keep secret keys and webhook secrets private.
MODEM_PUBLIC_KEY=
MODEM_LIVE_SECRET=
MODEM_TEST_SECRET=
MODEM_WEBHOOK_SECRET=
MODEM_TEST_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Optional upload size limit in bytes (default: 5 MiB)
MAX_CONTENT_LENGTH=5242880

# Indicative shipping research (xAI Responses API web_search)
XAI_API_KEY=
XAI_MODEL=grok-4.7
SHIPPING_WEIGHT_BANDS_KG=0.5,1,1.5,2,2.5,3,5,10,15,20
SHIPPING_ESTIMATE_MAX_DESTINATIONS_PER_RUN=10
SHIPPING_ESTIMATE_MAX_AGE_DAYS=30
SHIPPING_MAX_DESTINATIONS_PER_UTC_DAY=10

# Groq API key; set the real value in the Render service environment, not in Git
GROQ_API_KEY=
