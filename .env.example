# Copy to .env for local use. Never put real credentials in this template.

# Database
DATABASE_URL=

# Cloudinary image storage
CLOUDINARY_URL=

# Flask and admin settings
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_URL=http://127.0.0.1:5500
MAX_CONTENT_LENGTH=5242880

# Modem Pay credentials
MODEM_PUBLIC_KEY=
MODEM_LIVE_SECRET=
MODEM_TEST_SECRET=
MODEM_TEST_WEBHOOK_SECRET=
MODEM_WEBHOOK_SECRET=

PAYMENT_CURRENCY=USD

# PayPal credentials
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=

# Leave false until you intentionally enable production payments
ENABLE_LIVE_PAYMENTS=false

# Indicative shipping research uses the server-side Groq key above
SHIPPING_WEIGHT_BANDS_KG=0.5,1,1.5,2,2.5,3,5,10,15,20
SHIPPING_ESTIMATE_MAX_DESTINATIONS_PER_RUN=10
SHIPPING_BATCH_SIZE=10
SHIPPING_ESTIMATE_MAX_AGE_DAYS=30
SHIPPING_MAX_DESTINATIONS_PER_UTC_DAY=10
SHIPPING_RESEARCH_MAX_OUTPUT_TOKENS=1400
SHIPPING_RESEARCH_MAX_RETRIES=1
SHIPPING_REQUEST_DELAY_SECONDS=15
COMMUNITY_COURIER_LABEL=Community Courier

# Groq API key; set the real value in the Render service environment, not in Git
GROQ_API_KEY=
