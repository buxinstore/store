# Copy to .env for local use. Never put real credentials in this template.

# Database
DATABASE_URL=

# Cloudinary image storage
CLOUDINARY_URL=

# Flask and admin settings
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_URL=http://127.0.0.1:5500
MAX_CONTENT_LENGTH=5242880

# Modem Pay credentials
MODEM_PUBLIC_KEY=
MODEM_LIVE_SECRET=
MODEM_TEST_SECRET=
MODEM_TEST_WEBHOOK_SECRET=
MODEM_WEBHOOK_SECRET=

PAYMENT_CURRENCY=USD

# PayPal credentials
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=

# Leave false until you intentionally enable production payments
ENABLE_LIVE_PAYMENTS=false
